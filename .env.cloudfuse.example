# Encryption key for connected cloud tokens. Use 32 random bytes encoded as hex or base64.
# Example generation in PowerShell:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
CLOUDFUSE_MASTER_KEY=

# Optional: fixed public origin when the callback URL cannot be inferred from the request.
# CLOUDFUSE_PUBLIC_URL=https://cloudfuse.example.com

# Keep synthetic demo data off for real deployments.
CLOUDFUSE_DEMO_MODE=false

# Local demand-driven cache.
CLOUDFUSE_CACHE_DIR=C:\CloudFuse\cache
CLOUDFUSE_CACHE_MAX_BYTES=21474836480

# Optional online Google Drive OAuth app. Local Drive Desktop sync does not need these.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Optional online Microsoft identity / OneDrive OAuth app. Local OneDrive sync does not need these.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional online Dropbox app. Local Dropbox sync does not need these.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# S3 is configured per account in the CloudFuse UI.
# Each S3 connection stores its credentials encrypted with CLOUDFUSE_MASTER_KEY.
