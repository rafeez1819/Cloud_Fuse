# CloudFuse — self-hosted production environment
#
# Copy to `.env` for local dev (auto-loaded via `dotenv`), or set these as
# real environment variables in your container/host for production — do not
# ship a `.env` file inside a production image.

# ── Server ────────────────────────────────────────────────────────────────
# Port the app listens on. docker-compose.yml and scripts/start-prod.mjs both
# default to 7010 if this is unset.
PORT=7010
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string. Unset = falls back to an embedded, in-memory
# PGlite database (fine for a quick local demo; data is lost on restart —
# NEVER leave this unset in production).
# Local docker-compose Postgres:
DATABASE_URL=postgres://cloudfuse:cloudfuse@db:5432/cloudfuse
# Neon / managed Postgres example:
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/cloudfuse?sslmode=require

# ── Auth (Better Auth) ────────────────────────────────────────────────────
# Must be your real public origin in production (no trailing slash).
BETTER_AUTH_URL=http://localhost:7010
# Long random secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Explicit off-switch. Leave unset/"true" once you've configured a provider
# below. Set to "false" only to force a single dev user with no real auth.
VITE_AUTH_ENABLED=true

# Which login screen to render (baked in at BUILD time, not runtime):
#   standalone (default) -> direct OAuth to the providers below, no broker
#   broker                -> Grok-platform federated sign-in (only if you're
#                             redeploying back onto the Grok platform)
VITE_AUTH_MODE=standalone

# ── Standalone OAuth providers ────────────────────────────────────────────
# Each is independent — configure only the ones you want to offer. At least
# one is required for real sign-in; with none set, auth falls back to a
# single dev user (fine for local evaluation only, never production).

# Google — console.cloud.google.com > APIs & Services > Credentials
#   Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD) — the sign-in behind a OneDrive account.
# portal.azure.com > App registrations > New registration
#   Redirect URI (Web): {BETTER_AUTH_URL}/api/auth/callback/microsoft
#   Supported account types: "Accounts in any organizational directory and
#   personal Microsoft accounts" if you want consumer OneDrive users to sign in.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (default) accepts both personal and work/school accounts. Set to a
# specific tenant GUID to restrict sign-in to one organization.
MICROSOFT_TENANT_ID=common

# Dropbox — dropbox.com/developers/apps
#   Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ── Build target (rarely needs changing) ─────────────────────────────────
# "node-server" (default) builds a standalone Node server for self-hosting.
# Leave unset unless deploying to a specific platform (e.g. "vercel",
# "cloudflare-pages"). Vercel's own build sets VERCEL=1 automatically, which
# already selects the "vercel" preset without this being set.
# NITRO_PRESET=node-server
